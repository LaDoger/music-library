onic"}],"events":[{"type":"form","technique":"theme_2","text":"B: the opening motif restated, now redirected toward G minor"},{"type":"story","technique":"continuation","text":"continuation: the same rise is led into minor keys"}]},{"bar":10,"start_quarter":37.0,"duration_quarters":4.0,"key":"F","chords":[{"beat":1.0,"symbol":"Cm7","rn":"iv7/ii","function":"predominant of G minor; melody C5 on beat 1, chord sounds on beat 1.5"},{"beat":2.0,"symbol":"D","rn":"V/ii","function":"dominant of G minor, Eb5 suspended above"},{"beat":4.5,"symbol":"D7/F#","rn":"V65/ii","function":"dominant seventh of G minor"}],"events":[{"type":"tension_release","technique":"suspension_9_8","text":"Eb5 prepared in Cm7 is held over D and resolves to D5 on beat 4","beat":2.0},{"type":"colour_chord","technique":"added_note","text":"Minor ninth Eb5 over the D bass (D7b9 colour without C)","beat":2.0}]},{"bar":11,"start_quarter":41.0,"duration_quarters":4.0,"key":"F","chords":[{"beat":1.0,"symbol":"Gm","rn":"ii","function":"tonicized G minor"},{"beat":2.5,"symbol":"F#dim7/C","rn":"viio43/ii","function":"leading-tone seventh of G minor"},{"beat":3.0,"symbol":"Gm/D","rn":"ii64","function":"cadential 6/4 of G minor"},{"beat":4.5,"symbol":"Adim/E-","rn":"iio64/ii","function":"predominant of G minor"}],"events":[{"type":"counterpoint","technique":"contrary_motion","text":"Melody and bass move in contrary motion through the dim7 to the 6/4","beat":2.5}]},{"bar":12,"start_quarter":45.0,"duration_quarters":4.0,"key":"F","chords":[{"beat":1.0,"symbol":"Gm/D","rn":"ii64","function":"cadential 6/4 of G minor"},{"beat":2.5,"symbol":"?","rn":"?","function":"dominant of G minor","reason":"D–A–C sound over D; the third F# is absent."},{"beat":3.0,"symbol":"Gm/D","rn":"ii64","function":"G minor over D, A3 as added second"},{"beat":4.0,"symbol":"?","rn":"?","function":"link","reason":"G2–A2 bass under F4 only; no complete triad."}],"events":[{"type":"cadence","technique":"IAC","text":"Imperfect close in G minor 