    <miscellaneous>
      <miscellaneous-field name="analysis-json">{"meta":{"id":"bach_bwv846_prelude","parent_item_id":"bach_bwv846_prelude","title":"Well-Tempered Clavier: Prelude in C major","composer":"Johann Sebastian Bach","source_file":"files/scores/bach_bwv846_prelude.mid","quarter_range":[0,140.0],"bar_quarters":4.0,"time_signature":"4/4","key":"C","tempo":60.0,"midi_play_url":"files/scores/bach_bwv846_prelude.mid","source_licence":"PD","notation_notes":"35 bars of 4/4 from absolute quarter 0, no pickup, no repeats (Mutopia edition without the Schwencke bar). MIDI-derived score, not an Urtext. Every bar repeats one half-bar arpeggio figure, so one chord per bar is the harmonic rhythm; bars 33-34 break the figure. Bar 23 bass is G# in the MIDI (Ab in some editions); same pitch class.","source_page":"https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=5","suggested_arrangement_tempo":100,"sustain_events":[]},"draft":false,"reviewed_by":"claude-opus-5-5 (MusicBot) 2026-10-11","summary":"A single arpeggio figure, one chord per bar, carries the whole prelude. It moves from a C-major frame toward G (tonicized, not modulated), returns to C at bar 19, darkens through chromatic diminished sevenths, holds an eight-bar dominant pedal, and ends over a tonic pedal.","sections":[{"name":"Opening frame","start_bar":1,"end_bar":4,"mood":["calm","clear"],"description":"I–ii42–V65–I over a C bass."},{"name":"Toward G","start_bar":5,"end_bar":11,"mood":["open","hopeful"],"description":"Applied chords tonicize G; arrival on G at bar 11."},{"name":"Return to C","start_bar":12,"end_bar":19,"mood":["reflective","steady"],"description":"Diminished sevenths and a falling bass lead to C at bar 19."},{"name":"Chromatic turn","start_bar":20,"end_bar":23,"mood":["darkening","searching"],"description":"C7, Fmaj7 and two diminished sevenths over a chromatic bass."},{"name":"Dominant pedal","start_bar":24,"end_bar":31,"mood":["suspended","tense"],"description":"Eight bars on G; cadential 6/4 and sus chords delay resolution."},{"name":"Coda","start_bar":32,"end_bar":35,"mood":["settled","serene"],"description":"Tonic pedal; the figure breaks up and closes on C."}],"mood":[{"start_bar":1,"end_bar":4,"labels":["calm","clear"]},{"start_bar":5,"end_bar":11,"labels":["open","hopeful"]},{"start_bar":12,"end_bar":19,"labels":["reflective","steady"]},{"start_bar":20,"end_bar":23,"labels":["darkening","searching"]},{"start_bar":24,"end_bar":31,"labels":["suspended","tense"]},{"start_bar":32,"end_bar":35,"labels":["settled","serene"]}],"tricks":["Bars 1–4: I–ii42–V65–I over a held bass. The voice-leading moves by step and the bass hardly moves.","Bars 6–11: applied V42/V and V7/V make G feel like home briefly without a real key change.","Bars 20–23: bass F–F#–G#–G under diminished sevenths builds tension into the pedal.","Bars 24–31: dominant pedal with cadential 6/4 and V7sus4 chords, repeated to stretch the wait for the tonic."],"loop_candidates":[{"start_bar":1,"end_bar":3,"why":"I–ii42–V65 resolves back to bar 1 C; bar 4 already restates bar 1.","quarter_range":[0,12]},{"start_bar":24,"end_bar":27,"why":"G7–C/G–G7sus4–G7 over G pedal; ends on the chord it starts on.","quarter_range":[92,108],"requires_audition":true}],"hook_candidates":[{"start_bar":1,"end_bar":4,"why":"The best-known opening progression and figure."},{"start_bar":20,"end_bar":24,"why":"Chromatic bass rise and diminished sevenths into the pedal."}],"kpop_uses":[{"where":"verse","why":"Bars 1–3 loop as a soft arpeggio bed with room for a vocal."},{"where":"pre-chorus","why":"Bars 24–31 dominant pedal builds anticipation; cut before bar 32 to land the chorus."},{"where":"bridge","why":"Bars 20–23 chromatic diminished-seventh colour for a darker reset."},{"where":"chorus","why":"Bars 15–19 (I6–IV42–ii7–V7–I) give a full cadential cycle to repeat; no key lift is in the source."}],"review_flags":[{"bar":7,"reason":"Bars 7–11 read as tonicization of G with applied numerals and key C retained; a dominant-key modulation reading is possible."},{"bar":19,"reason":"Labelled IAC because the top sounding voice is E; some analyses call this the first PAC."},{"bar":23,"reason":"Bass spelled G# in the MIDI; editions differ (Ab). Held C is treated as a non-chord tone."},{"bar":26,"reason":"G7sus4 has no B; it could also be read as an ii7-over-G-pedal sonority (D–F–C over G)."},{"bar":33,"reason":"F/C absorbs a passing D on beat 4 rather than a separate ii label."}],"schema_version":1,"bars":[{"bar":1,"start_quarter":0.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"C","rn":"I","function":"tonic"}],"events":[{"type":"form","technique":"theme_1","text":"Opening phrase: one arpeggio figure, played twice per bar, carries the whole piece"},{"type":"story","technique":"start","text":"start: a calm C-major frame I–ii42–V65–I over a nearly fixed bass"},{"type":"hook","technique":"harmonic_cell","text":"I–ii42–V65–I with the top voice E–F–F–E"},{"type":"motif","technique":"repetition","text":"Each half-bar figure is repeated literally; harmony changes once per bar"}]},{"bar":2,"start_quarter":4.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Dm7/C","rn":"ii42","function":"predominant over held tonic bass"}],"events":[]},{"bar":3,"start_quarter":8.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"G7/B","rn":"V65","function":"dominant"}],"events":[]},{"bar":4,"start_quarter":12.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"C","rn":"I","function":"tonic"}],"events":[]},{"bar":5,"start_quarter":16.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Am/C","rn":"vi6","function":"tonic substitute"}],"events":[{"type":"story","technique":"continuation","text":"continuation: the harmony leans toward G"}]},{"bar":6,"start_quarter":20.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"D7/C","rn":"V42/V","function":"applied dominant"}],"events":[{"type":"bass_line","technique":"stepwise_descent","text":"Bass C–B–B–A (bars 6–9) under the move toward G"}]},{"bar":7,"start_quarter":24.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"G/B","rn":"V6","function":"dominant, tonicized"}],"events":[]},{"bar":8,"start_quarter":28.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Cmaj7/B","rn":"IV42/V","function":"predominant of G"}],"events":[]},{"bar":9,"start_quarter":32.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Am7","rn":"ii7/V","function":"predominant of G"}],"events":[]},{"bar":10,"start_quarter":36.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"D7","rn":"V7/V","function":"applied dominant"}],"events":[]},{"bar":11,"start_quarter":40.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"G","rn":"V","function":"tonicized dominant arrival"}],"events":[{"type":"cadence","technique":"HC","text":"V7/V–V arrival on G: authentic in G, a half-cadence-like close in C (tonicization, not modulation)"}]},{"bar":12,"start_quarter":44.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"C#dim7/G","rn":"viio43/ii","function":"applied leading-tone chord to ii"}],"events":[{"type":"colour_chord","technique":"dim7_colour","text":"C#dim7 over G pulls to D minor (viio7/ii)"}]},{"bar":13,"start_quarter":48.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Dm/F","rn":"ii6","function":"predominant"}],"events":[{"type":"bass_line","technique":"stepwise_descent","text":"Bass descends in paired bars G–F–E–D (bars 11–17) back to the tonic cadence"}]},{"bar":14,"start_quarter":52.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"Bdim7/F","rn":"viio43","function":"dominant (leading-tone)"}],"events":[{"type":"colour_chord","technique":"dim7_colour","text":"Bdim7 over F, resolving to C/E"}]},{"bar":15,"start_quarter":56.0,"duration_quarters":4.0,"key":"C","chords":[{"beat":1.0,"symbol":"C/E","rn":"I6","function":"tonic"}],"events":[]},{"bar"